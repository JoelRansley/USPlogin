<script>
(function(){
  "use strict";
  var STORE_KEY = "studentPortal.v1";
  var SESSION_KEY = "studentPortal.session";

  // ---- login gate (accepts any email/password combination) ----
  var loginScreen = document.getElementById("loginScreen");
  var appEl = document.getElementById("app");
  var loginError = document.getElementById("loginError");

  function showApp(){
    loginScreen.classList.add("hidden");
    appEl.style.display = "";
  }
  function showLogin(){
    appEl.style.display = "none";
    loginScreen.classList.remove("hidden");
    loginError.style.display = "none";
    document.getElementById("loginEmail").value = "";
    document.getElementById("loginPassword").value = "";
  }

  appEl.style.display = "none"; // hidden until login resolves

  if(sessionStorage.getItem(SESSION_KEY) === "1"){
    showApp();
  } else {
    showLogin();
  }

  document.getElementById("loginBtn").addEventListener("click", function(){
    // Any non-empty email/password combination is accepted.
    var email = document.getElementById("loginEmail").value.trim();
    var pw = document.getElementById("loginPassword").value;
    if(!email || !pw){
      loginError.textContent = "Preencha e-mail e senha para continuar.";
      loginError.style.display = "block";
      return;
    }
    sessionStorage.setItem(SESSION_KEY, "1");
    showApp();
  });

  ["loginEmail","loginPassword"].forEach(function(id){
    document.getElementById(id).addEventListener("keydown", function(e){
      if(e.key === "Enter") document.getElementById("loginBtn").click();
    });
  });

  document.getElementById("logoutLink").addEventListener("click", function(){
    sessionStorage.removeItem(SESSION_KEY);
    showLogin();
  });

  var defaultData = {
    inst: "Universidade de São Paulo",
    name: "Nome do Estudante",
    ra: "0000000",
    course: "Arquitetura e Urbanismo",
    unit: "Faculdade de Arquitetura e Urbanismo (FAU)",
    validity: "12/2026",
    email: "",
    phone: "",
    birth: "",
    address: "",
    photo: "",
    classes: [
      { name:"Projeto de Arquitetura V", code:"AUT0345", day:"Segunda", time:"08:00–12:00", room:"Ateliê 3" },
      { name:"História da Arquitetura Moderna", code:"AUH0212", day:"Segunda", time:"14:00–16:00", room:"Sala 8" },
      { name:"Sistemas Estruturais II", code:"AUT0512", day:"Terça", time:"08:00–10:00", room:"Sala 15" },
      { name:"Projeto de Arquitetura V", code:"AUT0345", day:"Quarta", time:"08:00–12:00", room:"Ateliê 3" },
      { name:"Conforto Ambiental e Eficiência Energética", code:"AUT0433", day:"Quarta", time:"14:00–16:00", room:"Sala 10" },
      { name:"Urbanismo Contemporâneo", code:"AUP0350", day:"Quinta", time:"10:00–12:00", room:"Sala 6" },
      { name:"Materiais e Técnicas Construtivas", code:"AUT0298", day:"Sexta", time:"08:00–10:00", room:"Laboratório de Materiais" }
    ]
  };

  function load(){
    try{
      var raw = localStorage.getItem(STORE_KEY);
      if(!raw) return JSON.parse(JSON.stringify(defaultData));
      var parsed = JSON.parse(raw);
      return Object.assign(JSON.parse(JSON.stringify(defaultData)), parsed);
    }catch(e){ return JSON.parse(JSON.stringify(defaultData)); }
  }
  function save(data){ localStorage.setItem(STORE_KEY, JSON.stringify(data)); }

  var data = load();

  // ---- render ID ----
  function renderId(){
    document.getElementById("instName").textContent = data.inst || "Universidade";
    document.getElementById("idName").textContent = data.name || "Nome do Estudante";
    document.getElementById("idRA").textContent = data.ra || "—";
    document.getElementById("idCourse").textContent = data.course || "—";
    document.getElementById("idUnit").textContent = data.unit || "—";
    document.getElementById("idValidity").textContent = data.validity || "—";
    var box = document.getElementById("idPhotoBox");
    box.innerHTML = data.photo ? '<img src="'+data.photo+'" alt="Foto">' : "FOTO";
  }

  // ---- render details ----
  function renderDetails(){
    var list = document.getElementById("detailsList");
    var rows = [
      ["Nome", data.name],
      ["RA / Matrícula", data.ra],
      ["Curso", data.course],
      ["Unidade", data.unit],
      ["E-mail", data.email || "—"],
      ["Telefone", data.phone || "—"],
      ["Nascimento", data.birth || "—"],
      ["Endereço", data.address || "—"]
    ];
    list.innerHTML = rows.map(function(r){
      return '<div class="drow"><span class="dlbl">'+r[0]+'</span><span class="dval">'+escapeHtml(r[1] || "—")+'</span></div>';
    }).join("");
  }

  function escapeHtml(s){
    return String(s).replace(/[&<>"']/g, function(c){
      return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];
    });
  }

  // ---- render classes ----
  var dayOrder = ["Segunda","Terça","Quarta","Quinta","Sexta","Sábado","Domingo"];
  function renderClasses(){
    var body = document.getElementById("classesBody");
    var empty = document.getElementById("classesEmpty");
    var sorted = data.classes.slice().sort(function(a,b){
      return dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day) || (a.time||"").localeCompare(b.time||"");
    });
    if(sorted.length === 0){
      body.innerHTML = "";
      empty.style.display = "block";
      return;
    }
    empty.style.display = "none";
    body.innerHTML = sorted.map(function(c, idx){
      return '<tr>'+
        '<td><span class="day-tag">'+escapeHtml(c.day)+'</span><br>'+escapeHtml(c.time||"—")+'</td>'+
        '<td><div class="class-name">'+escapeHtml(c.name)+'</div>'+(c.code ? '<div class="class-sub">'+escapeHtml(c.code)+'</div>' : '')+'</td>'+
        '<td>'+escapeHtml(c.room || "—")+'</td>'+
        '</tr>';
    }).join("");
  }

  function renderAll(){ renderId(); renderDetails(); renderClasses(); }
  renderAll();

  // ---- tab navigation ----
  var tabBtns = document.querySelectorAll(".tab-btn");
  tabBtns.forEach(function(btn){
    btn.addEventListener("click", function(){
      tabBtns.forEach(function(b){ b.classList.remove("active"); });
      btn.classList.add("active");
      document.querySelectorAll(".view").forEach(function(v){ v.classList.remove("active"); });
      document.getElementById(btn.dataset.view).classList.add("active");
    });
  });

  // ---- clock ----
  function tick(){
    var d = new Date();
    var hh = String(d.getHours()).padStart(2,"0");
    var mm = String(d.getMinutes()).padStart(2,"0");
    document.getElementById("clock").textContent = hh+":"+mm;
  }
  tick(); setInterval(tick, 15000);

  // ---- edit sheet ----
  var editOverlay = document.getElementById("editOverlay");
  var editPhotoData = "";

  function openEdit(){
    document.getElementById("f-inst").value = data.inst || "";
    document.getElementById("f-name").value = data.name || "";
    document.getElementById("f-ra").value = data.ra || "";
    document.getElementById("f-validity").value = data.validity || "";
    document.getElementById("f-course").value = data.course || "";
    document.getElementById("f-unit").value = data.unit || "";
    document.getElementById("f-email").value = data.email || "";
    document.getElementById("f-phone").value = data.phone || "";
    document.getElementById("f-birth").value = data.birth || "";
    document.getElementById("f-address").value = data.address || "";
    editPhotoData = data.photo || "";
    var pv = document.getElementById("editPhotoPreview");
    pv.innerHTML = editPhotoData ? '<img src="'+editPhotoData+'" alt="Foto">' : "FOTO";
    editOverlay.classList.add("active");
  }
  document.getElementById("editDetailsBtn").addEventListener("click", openEdit);
  document.getElementById("editDetailsBtn2").addEventListener("click", openEdit);
  document.getElementById("cancelEdit").addEventListener("click", function(){ editOverlay.classList.remove("active"); });

  document.getElementById("photoInput").addEventListener("change", function(e){
    var file = e.target.files[0];
    if(!file) return;
    var reader = new FileReader();
    reader.onload = function(ev){
      editPhotoData = ev.target.result;
      document.getElementById("editPhotoPreview").innerHTML = '<img src="'+editPhotoData+'" alt="Foto">';
    };
    reader.readAsDataURL(file);
  });

  document.getElementById("saveEdit").addEventListener("click", function(){
    data.inst = document.getElementById("f-inst").value.trim() || defaultData.inst;
    data.name = document.getElementById("f-name").value.trim() || defaultData.name;
    data.ra = document.getElementById("f-ra").value.trim();
    data.validity = document.getElementById("f-validity").value.trim();
    data.course = document.getElementById("f-course").value.trim();
    data.unit = document.getElementById("f-unit").value.trim();
    data.email = document.getElementById("f-email").value.trim();
    data.phone = document.getElementById("f-phone").value.trim();
    data.birth = document.getElementById("f-birth").value.trim();
    data.address = document.getElementById("f-address").value.trim();
    data.photo = editPhotoData;
    save(data);
    renderAll();
    editOverlay.classList.remove("active");
  });

  // ---- add class sheet ----
  var classOverlay = document.getElementById("classOverlay");
  document.getElementById("addClassBtn").addEventListener("click", function(){
    document.getElementById("c-name").value = "";
    document.getElementById("c-code").value = "";
    document.getElementById("c-day").value = "Segunda";
    document.getElementById("c-time").value = "";
    document.getElementById("c-room").value = "";
    classOverlay.classList.add("active");
  });
  document.getElementById("cancelClass").addEventListener("click", function(){ classOverlay.classList.remove("active"); });
  document.getElementById("saveClass").addEventListener("click", function(){
    var name = document.getElementById("c-name").value.trim();
    if(!name){ document.getElementById("c-name").focus(); return; }
    data.classes.push({
      name: name,
      code: document.getElementById("c-code").value.trim(),
      day: document.getElementById("c-day").value,
      time: document.getElementById("c-time").value.trim(),
      room: document.getElementById("c-room").value.trim()
    });
    save(data);
    renderClasses();
    classOverlay.classList.remove("active");
  });

  // allow tap on a class row to delete (long-press-free simple UX)
  document.getElementById("classesBody").addEventListener("click", function(e){
    var tr = e.target.closest("tr");
    if(!tr) return;
    var idx = Array.prototype.indexOf.call(tr.parentNode.children, tr);
    var sorted = data.classes.slice().sort(function(a,b){
      return dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day) || (a.time||"").localeCompare(b.time||"");
    });
    var target = sorted[idx];
    if(!target) return;
    if(confirm('Remover "'+target.name+'" da grade?')){
      var realIdx = data.classes.indexOf(target);
      data.classes.splice(realIdx,1);
      save(data);
      renderClasses();
    }
  });

  // close sheets on backdrop tap
  [editOverlay, classOverlay].forEach(function(ov){
    ov.addEventListener("click", function(e){
      if(e.target === ov) ov.classList.remove("active");
    });
  });

  // register service worker for offline installability (optional, best-effort)
  if("serviceWorker" in navigator){
    navigator.serviceWorker.register("sw.js").catch(function(){});
  }
})();
</script>
</body>
</html>
